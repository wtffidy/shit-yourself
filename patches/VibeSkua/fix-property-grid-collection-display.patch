+    /// <summary>
+    /// Formats property values without displaying collection type names.
+    /// </summary>
+    private static string FormatValue(object? value)
+    {
+        if (value == null)
+            return "null";
+
+        if (value is bool booleanValue)
+            return booleanValue ? "True" : "False";
+
+        if (value is string stringValue)
+            return stringValue;
+
+        if (value is IEnumerable enumerable)
+        {
+            const int maxItems = 20;
+            System.Text.StringBuilder builder = new("[");
+            int count = 0;
+
+            foreach (object? item in enumerable)
+            {
+                if (count >= maxItems)
+                {
+                    builder.Append(", ...");
+                    break;
+                }
+
+                if (count > 0)
+                    builder.Append(", ");
+
+                builder.Append(FormatCollectionItem(item));
+                count++;
+            }
+
+            builder.Append(']');
+            return builder.ToString();
+        }
+
+        return value.ToString() ?? string.Empty;
+    }
+
+    /// <summary>
+    /// Formats collection entries using their ID and name when those properties are available.
+    /// </summary>
+    private static string FormatCollectionItem(object? item)
+    {
+        if (item == null)
+            return "null";
+
+        Type itemType = item.GetType();
+        PropertyInfo? idProperty = itemType.GetProperty("ID") ?? itemType.GetProperty("Id");
+        PropertyInfo? nameProperty = itemType.GetProperty("Name");
+
+        if (idProperty != null && nameProperty != null)
+        {
+            object? id = idProperty.GetValue(item);
+            object? name = nameProperty.GetValue(item);
+
+            if (id != null && name != null)
+                return $"[{id}] {name}";
+            if (name != null)
+                return name.ToString() ?? string.Empty;
+        }
+
+        return item.ToString() ?? itemType.Name;
+    }
+
     private void UpdateVisibility()
     {
         bool hasProps = _properties.Count > 0;
         EmptyTextBlock.IsVisible = !hasProps;
         ContentScrollViewer.IsVisible = hasProps;
     }
